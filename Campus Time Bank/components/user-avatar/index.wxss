.ua {
  position: relative;
  flex-shrink: 0;
  border-radius: 50%;
  overflow: visible;
}

.ua--ring {
  box-shadow: 0 0 0 4rpx rgba(255, 255, 255, 0.9);
}

.ua__img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: var(--c-line);
  display: block;
}

.ua__ph {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ua__ch {
  color: #fff;
  font-weight: 600;
  line-height: 1;
}

.ua__verified {
  position: absolute;
  right: -2rpx;
  bottom: -2rpx;
  border-radius: 50%;
  background: var(--c-primary);
  border: 3rpx solid #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.ua__verified-icon {
  color: #fff;
  font-weight: 700;
  line-height: 1;
}

.ua__credit {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  bottom: -14rpx;
  height: 28rpx;
  padding: 0 10rpx;
  border-radius: 999rpx;
  background: var(--c-info);
  color: #fff;
  font-size: 19rpx;
  font-weight: 600;
  line-height: 28rpx;
  white-space: nowrap;
  border: 2rpx solid #fff;
  box-sizing: border-box;
}
