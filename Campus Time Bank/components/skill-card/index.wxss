/* ==================================================================
 * 技能卡片
 * 结构：上半 .sc（封面 + 主体） + 下半 .sc-author（作者条）
 * 两段拼成一张完整卡片，列表里直接连续排布即可。
 * ================================================================== */
.sc {
  display: flex;
  flex-direction: row;
  background: var(--c-card);
  border-radius: var(--r-m) var(--r-m) 0 0;
  padding: var(--sp);
  box-shadow: var(--sh-1);
  transition: transform .12s;
}

.sc--hover {
  transform: scale(0.992);
}

/* ---------------- 封面 ---------------- */
.sc__cover {
  position: relative;
  width: 168rpx;
  height: 168rpx;
  border-radius: var(--r-s);
  flex-shrink: 0;
  margin-right: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.sc__cover-img {
  width: 100%;
  height: 100%;
}

.sc__cover-icon {
  font-size: 72rpx;
  line-height: 1;
  opacity: .95;
}

.sc__type {
  position: absolute;
  left: 0;
  top: 0;
  height: 36rpx;
  padding: 0 14rpx;
  border-radius: var(--r-s) 0 var(--r-s) 0;
  font-size: 20rpx;
  line-height: 36rpx;
  color: #fff;
  font-weight: 500;
}

.sc__type.is-offer { background: rgba(14, 164, 122, .92); }
.sc__type.is-need { background: rgba(59, 130, 246, .92); }

/* ---------------- 主体 ---------------- */
.sc__main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.sc__title {
  font-size: var(--fs-h3);
  font-weight: 600;
  color: var(--c-t1);
  line-height: 1.4;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.sc__tags {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 10rpx;
}

.sc__tag {
  height: 36rpx;
  padding: 0 12rpx;
  border-radius: 6rpx;
  background: var(--c-bg);
  color: var(--c-t2);
  font-size: 20rpx;
  line-height: 36rpx;
}

.sc__meta {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-top: 14rpx;
}

.sc__meta-sep {
  color: var(--c-t4);
  margin: 0 8rpx;
  font-size: var(--fs-cap);
}

.sc__meta-text {
  font-size: var(--fs-cap);
  color: var(--c-t2);
}

.sc__distance {
  font-size: var(--fs-mini);
  color: var(--c-t3);
}

/* ---------------- 作者条 ---------------- */
.sc-author {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
  background: var(--c-card);
  border-radius: 0 0 var(--r-m) var(--r-m);
  padding: 16rpx var(--sp) 20rpx;
  box-shadow: var(--sh-1);
  position: relative;
}

.sc-author::before {
  content: '';
  position: absolute;
  left: var(--sp);
  right: var(--sp);
  top: 0;
  height: 2rpx;
  background: var(--c-line);
}

.sc-author__name {
  font-size: var(--fs-cap);
  color: var(--c-t1);
  font-weight: 500;
  max-width: 220rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.sc-author__stat {
  font-size: var(--fs-mini);
  color: var(--c-t3);
  margin-left: 14rpx;
}
