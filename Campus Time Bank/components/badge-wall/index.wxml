<view class="bw">
  <view
    wx:for="{{render}}"
    wx:for-item="b"
    wx:key="id"
    class="bw__item {{b.owned ? '' : 'is-locked'}}"
    style="width:{{itemWidth}}%;"
    data-badge="{{b}}"
    bindtap="onTap"
  >
    <view class="bw__icon" style="{{b.owned ? 'background:' + b.color + '1A;box-shadow:0 0 0 3rpx ' + b.color + '33' : ''}}">
      <text class="bw__emoji">{{b.icon}}</text>
    </view>
    <text class="bw__name" style="{{b.owned ? 'color:' + b.color : ''}}">{{b.name}}</text>
    <text wx:if="{{b.showDesc && b.desc}}" class="bw__desc">{{b.desc}}</text>
  </view>
</view>
