.bw {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
}

.bw__item {
  /* width 由组件内联 style 按 cols 计算，不要在 CSS 里写死列数 */
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 6rpx;
  box-sizing: border-box;
}

.bw__icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: var(--c-bg);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform .15s;
}

.bw__item:active .bw__icon {
  transform: scale(0.93);
}

.bw__emoji {
  font-size: 48rpx;
  line-height: 1;
}

.bw__item.is-locked .bw__icon {
  background: #F2F4F6;
}

.bw__item.is-locked .bw__emoji {
  filter: grayscale(100%);
  opacity: .35;
}

.bw__name {
  margin-top: 12rpx;
  font-size: var(--fs-mini);
  color: var(--c-t2);
  font-weight: 500;
  text-align: center;
  line-height: 1.3;
}

.bw__item.is-locked .bw__name {
  color: var(--c-t4);
}

.bw__desc {
  margin-top: 4rpx;
  font-size: 19rpx;
  color: var(--c-t3);
  text-align: center;
  line-height: 1.3;
}
