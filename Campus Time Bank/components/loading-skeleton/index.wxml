<!-- 技能卡片骨架 -->
<block wx:if="{{type === 'skill'}}">
  <view wx:for="{{rows}}" wx:key="*this" class="sk-wrap">
    <view class="sk-card">
      <view class="sk sk-card__cover"></view>
      <view class="sk-card__main">
        <view class="sk sk-line sk-line--80"></view>
        <view class="sk sk-line sk-line--55"></view>
        <view class="sk sk-line sk-line--35"></view>
      </view>
    </view>
    <view class="sk-card__foot">
      <view class="sk sk-circle"></view>
      <view class="sk sk-line sk-line--25"></view>
    </view>
  </view>
</block>

<!-- 订单卡片骨架 -->
<block wx:elif="{{type === 'order'}}">
  <view wx:for="{{rows}}" wx:key="*this" class="sk-wrap">
    <view class="sk sk-line sk-line--40" style="margin:24rpx 0 0 24rpx;"></view>
    <view class="sk-card" style="padding-top:24rpx;">
      <view class="sk sk-card__cover" style="width:132rpx;height:132rpx;"></view>
      <view class="sk-card__main">
        <view class="sk sk-line sk-line--75"></view>
        <view class="sk sk-line sk-line--40"></view>
      </view>
    </view>
    <view class="sk-card__foot">
      <view class="sk sk-circle"></view>
      <view class="sk sk-line sk-line--25"></view>
    </view>
  </view>
</block>

<!-- 详情骨架 -->
<block wx:elif="{{type === 'detail'}}">
  <view class="sk-detail">
    <view class="sk" style="width:100%;height:420rpx;border-radius:0;"></view>
    <view class="sk-detail__body">
      <view class="sk sk-line sk-line--70" style="height:44rpx;"></view>
      <view class="sk sk-line sk-line--45"></view>
      <view class="sk sk-line sk-line--90" style="margin-top:32rpx;"></view>
      <view class="sk sk-line sk-line--85"></view>
      <view class="sk sk-line sk-line--60"></view>
    </view>
  </view>
</block>

<!-- 宫格骨架 -->
<block wx:elif="{{type === 'grid'}}">
  <view class="sk-grid">
    <view wx:for="{{rows}}" wx:key="*this" class="sk sk-grid__item"></view>
  </view>
</block>

<!-- 通用列表骨架 -->
<block wx:else>
  <view wx:for="{{rows}}" wx:key="*this" class="sk-wrap">
    <view class="sk-card">
      <view class="sk sk-card__cover" style="width:0;margin-right:0;"></view>
      <view class="sk-card__main">
        <view class="sk sk-line sk-line--70"></view>
        <view class="sk sk-line sk-line--45"></view>
      </view>
    </view>
  </view>
</block>
