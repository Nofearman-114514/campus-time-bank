.sk-wrap {
  background: var(--c-card);
  border-radius: var(--r-m);
  box-shadow: var(--sh-1);
  margin-bottom: 20rpx;
  overflow: hidden;
}

.sk-card {
  display: flex;
  flex-direction: row;
  padding: var(--sp);
}

.sk-card__cover {
  width: 168rpx;
  height: 168rpx;
  border-radius: var(--r-s);
  flex-shrink: 0;
  margin-right: 20rpx;
}

.sk-card__main {
  flex: 1;
  min-width: 0;
  padding-top: 6rpx;
}

.sk-card__foot {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 14rpx;
  padding: 0 var(--sp) 24rpx;
}

.sk-line {
  height: 28rpx;
  margin-bottom: 16rpx;
}

.sk-line--25 { width: 25%; }
.sk-line--35 { width: 35%; }
.sk-line--40 { width: 40%; }
.sk-line--45 { width: 45%; }
.sk-line--55 { width: 55%; }
.sk-line--60 { width: 60%; }
.sk-line--70 { width: 70%; }
.sk-line--75 { width: 75%; }
.sk-line--80 { width: 80%; }
.sk-line--85 { width: 85%; }
.sk-line--90 { width: 90%; }

.sk-circle {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
}

.sk-detail__body {
  padding: var(--sp);
}

.sk-grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 20rpx;
}

.sk-grid__item {
  width: calc(50% - 10rpx);
  height: 200rpx;
  border-radius: var(--r-m);
}
