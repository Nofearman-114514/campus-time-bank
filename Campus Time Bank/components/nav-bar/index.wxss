.nb {
  width: 100%;
  z-index: 200;
}

.nb--fixed {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
}

.nb__bar {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 0 20rpx;
  position: relative;
}

.nb__left {
  width: 180rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  z-index: 2;
}

.nb__back {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background-color .15s;
}

.nb__back:active {
  background: rgba(0, 0, 0, .06);
}

.nb__back-icon {
  font-size: 52rpx;
  line-height: 1;
  margin-top: -6rpx;
  font-weight: 300;
}

.nb__title {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  max-width: 380rpx;
  font-size: var(--fs-h3);
  font-weight: 600;
  text-align: center;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.nb__right {
  flex: 1;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: flex-end;
}
