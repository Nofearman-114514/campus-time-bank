.oc {
  background: var(--c-card);
  border-radius: var(--r-m);
  box-shadow: var(--sh-1);
  overflow: hidden;
  transition: transform .12s;
}

.oc--hover { transform: scale(0.993); }

/* ---------------- 头部 ---------------- */
.oc__head {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 20rpx var(--sp) 0;
}

.oc__no {
  font-size: var(--fs-mini);
  color: var(--c-t3);
  font-variant-numeric: tabular-nums;
}

.oc__role {
  height: 34rpx;
  padding: 0 12rpx;
  margin-right: 12rpx;
  border-radius: 6rpx;
  background: var(--c-bg);
  color: var(--c-t2);
  font-size: 20rpx;
  line-height: 34rpx;
}

.oc__status {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8rpx;
  font-size: var(--fs-cap);
  font-weight: 600;
}

.oc__status--waiting { color: var(--c-warn); }
.oc__status--ongoing { color: var(--c-info); }
.oc__status--confirming { color: var(--c-accent); }
.oc__status--finished { color: var(--c-success); }
.oc__status--canceled { color: var(--c-t3); }
.oc__status--closed { color: var(--c-t3); }

/* ---------------- 主体 ---------------- */
.oc__body {
  display: flex;
  flex-direction: row;
  padding: 20rpx var(--sp) 0;
}

.oc__cover {
  width: 132rpx;
  height: 132rpx;
  border-radius: var(--r-s);
  flex-shrink: 0;
  margin-right: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.oc__cover-img { width: 100%; height: 100%; }

.oc__cover-icon {
  font-size: 60rpx;
  line-height: 1;
}

.oc__info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.oc__title {
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--c-t1);
  line-height: 1.45;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.oc__meta {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-top: 10rpx;
}

.oc__meta-sep { color: var(--c-t4); margin: 0 8rpx; font-size: var(--fs-cap); }
.oc__meta-text { font-size: var(--fs-cap); color: var(--c-t2); }

.oc__remark {
  margin-top: 10rpx;
  font-size: var(--fs-mini);
  color: var(--c-t3);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* ---------------- 底部 ---------------- */
.oc__foot {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 14rpx;
  padding: 20rpx var(--sp);
  margin-top: 20rpx;
  position: relative;
}

.oc__foot::before {
  content: '';
  position: absolute;
  left: var(--sp);
  right: var(--sp);
  top: 0;
  height: 2rpx;
  background: var(--c-line);
}

.oc__counterpart {
  display: flex;
  flex-direction: column;
  justify-content: center;
  max-width: 200rpx;
}

.oc__cp-name {
  font-size: var(--fs-cap);
  color: var(--c-t1);
  font-weight: 500;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.oc__cp-label {
  font-size: 20rpx;
  color: var(--c-t3);
  line-height: 1.3;
}

.oc__actions {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}
