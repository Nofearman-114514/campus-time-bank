/* ==================================================================
 * 发表评价
 * ================================================================== */

.rv-name {
  font-size: var(--fs-h3);
  font-weight: 600;
  color: var(--c-t1);
}
.rv-skill {
  margin-top: 8rpx;
  font-size: var(--fs-cap);
  color: var(--c-t3);
}

/* ---------------------------- 星级评分 ---------------------------- */
.rate-card {
  margin-top: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx var(--sp);
}
.rate-card__label {
  font-size: var(--fs-body);
  color: var(--c-t2);
}
.rate-card__stars { margin: 24rpx 0 12rpx; }
.rate-card__text {
  font-size: var(--fs-h2);
  font-weight: 700;
}
.rate-card__text--good { color: var(--c-success); }
.rate-card__text--mid { color: var(--c-warn); }
.rate-card__text--bad { color: var(--c-danger); }
.rate-card__hint {
  margin-top: 16rpx;
  font-size: var(--fs-mini);
  color: var(--c-t4);
  text-align: center;
  line-height: 1.6;
}

/* ---------------------------- 标签多选 ---------------------------- */
.tag-pick {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.tag-pick__item {
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 26rpx;
  border-radius: var(--r-full);
  font-size: var(--fs-cap);
  color: var(--c-t2);
  background: var(--c-bg);
  border: 2rpx solid transparent;
  transition: all .15s;
}
.tag-pick__item--on {
  background: var(--c-primary);
  color: #fff;
  font-weight: 600;
  box-shadow: var(--sh-primary);
}

/* ---------------------------- 表单 ---------------------------- */
.form-card {
  padding: 0;
  overflow: hidden;
}
.form-card .form-item:last-child { padding-bottom: 8rpx; }

/* ---------------------------- 匿名 ---------------------------- */
.anon-title {
  font-size: var(--fs-body);
  color: var(--c-t1);
}
.anon-desc {
  margin-top: 6rpx;
  font-size: var(--fs-mini);
  color: var(--c-t3);
}
