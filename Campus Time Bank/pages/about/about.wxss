/* 关于 / 平台规则 */

/* ---------------- App 介绍卡 ---------------- */
.app-card {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 24rpx;
}

.app-card__logo {
  width: 128rpx;
  height: 128rpx;
  border-radius: var(--r-l);
  background: var(--g-primary);
  box-shadow: var(--sh-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.app-card__logo-emoji {
  font-size: 64rpx;
  line-height: 1;
}

.app-card__name {
  font-size: var(--fs-h2);
  font-weight: 700;
  color: var(--c-t1);
}
.app-card__slogan {
  margin-top: 6rpx;
  font-size: var(--fs-cap);
  color: var(--c-t2);
}
.app-card__ver {
  margin-top: 10rpx;
  display: inline-block;
  padding: 2rpx 16rpx;
  border-radius: var(--r-full);
  background: var(--c-primary-l);
  color: var(--c-primary);
  font-size: var(--fs-mini);
}

/* ---------------- 通用区块 ---------------- */
.block { margin-top: 20rpx; }

.block__title {
  font-size: var(--fs-h3);
  font-weight: 600;
  color: var(--c-t1);
  position: relative;
  padding-left: 20rpx;
  margin-bottom: 16rpx;
}
.block__title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 8rpx;
  height: 28rpx;
  border-radius: 4rpx;
  background: var(--c-primary);
}
.block__title--inline {
  margin-bottom: 0;
  padding-left: 0;
  font-size: var(--fs-h3);
}
.block__title--inline::before { display: none; }

.block__more {
  font-size: var(--fs-cap);
  color: var(--c-primary);
}

.block__p {
  font-size: var(--fs-cap);
  color: var(--c-t2);
  line-height: 1.8;
  margin-top: 10rpx;
}
.block__p--minor {
  font-size: var(--fs-mini);
  color: var(--c-t3);
}

.block__strong {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  border-radius: var(--r-s);
  background: var(--c-accent-l);
  color: var(--c-accent);
  font-size: var(--fs-cap);
  font-weight: 600;
  line-height: 1.6;
}

.block__li {
  font-size: var(--fs-cap);
  color: var(--c-t2);
  line-height: 1.8;
  margin-top: 10rpx;
}

/* ---------------- 交易流程（4 步流程图） ---------------- */
.flow { margin-top: 8rpx; }

.flow__row {
  display: flex;
  flex-direction: row;
  align-items: stretch;
  gap: 20rpx;
}

.flow__left {
  width: 72rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
}

.flow__dot {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--c-primary-l);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.flow__dot-icon { font-size: 36rpx; line-height: 1; }

.flow__line {
  flex: 1;
  width: 3rpx;
  margin: 6rpx 0;
  background: var(--c-line);
  min-height: 40rpx;
}

.flow__body {
  flex: 1;
  min-width: 0;
  padding-bottom: 28rpx;
}

.flow__title {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 14rpx;
}
.flow__step {
  font-size: var(--fs-mini);
  color: var(--c-primary);
  font-weight: 700;
  letter-spacing: 1rpx;
}
.flow__name {
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--c-t1);
}
.flow__desc {
  margin-top: 6rpx;
  font-size: var(--fs-cap);
  color: var(--c-t2);
  line-height: 1.6;
}

/* ---------------- 信用分规则 ---------------- */
.rules { margin-top: 12rpx; }

.rule {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
  min-height: 80rpx;
  position: relative;
}
.rule + .rule::before {
  content: '';
  position: absolute;
  left: 28rpx;
  right: 0;
  top: 0;
  height: 2rpx;
  background: var(--c-line);
}

.rule__dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--c-primary);
  flex-shrink: 0;
}
.rule__text {
  font-size: var(--fs-cap);
  color: var(--c-t1);
}
.rule__change {
  font-size: var(--fs-body);
  font-weight: 700;
  flex-shrink: 0;
}

/* ---------------- 联系我们（复用 cell 原子类） ---------------- */
.block .cell-group {
  box-shadow: none;
  border: 2rpx solid var(--c-line);
  margin-top: 8rpx;
}

/* ---------------- 运行模式提示 ---------------- */
.modebar {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: 16rpx;
  margin-top: 24rpx;
  padding: 24rpx;
  border-radius: var(--r-m);
}
.modebar--mock {
  background: var(--c-warn-l);
  border: 2rpx solid var(--c-warn);
}
.modebar--cloud {
  background: var(--c-success-l);
  border: 2rpx solid var(--c-success);
}
.modebar__icon {
  font-size: var(--fs-h3);
  line-height: 1.3;
  flex-shrink: 0;
}
.modebar--mock .modebar__title { color: var(--c-warn); }
.modebar--cloud .modebar__title { color: var(--c-success); }
.modebar__title {
  font-size: var(--fs-body);
  font-weight: 600;
}
.modebar__desc {
  margin-top: 6rpx;
  font-size: var(--fs-mini);
  color: var(--c-t2);
  line-height: 1.6;
}

/* ---------------- 页脚 ---------------- */
.about-foot {
  margin: 40rpx 0 20rpx;
  text-align: center;
  font-size: var(--fs-mini);
  color: var(--c-t4);
}
