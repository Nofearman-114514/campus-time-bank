/* 消息列表 */

/* ---------------- 系统通知入口卡 ---------------- */
.notice-entry {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 20rpx;
  margin: var(--sp);
  padding: 24rpx;
  border-radius: var(--r-m);
  background: var(--c-card);
  box-shadow: var(--sh-1);
  box-sizing: border-box;
}
.notice-entry:active { background: var(--c-bg); }

.notice-entry__icon {
  width: 76rpx;
  height: 76rpx;
  border-radius: var(--r-full);
  background: var(--c-primary-l);
  font-size: 40rpx;
  line-height: 76rpx;
  text-align: center;
  flex-shrink: 0;
}

.notice-entry__title {
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--c-t1);
}
.notice-entry__dot { margin-left: 12rpx; }

.notice-entry__desc {
  margin-top: 4rpx;
  font-size: var(--fs-cap);
  color: var(--c-t3);
  max-width: 420rpx;
}

.notice-entry__time {
  font-size: var(--fs-mini);
  color: var(--c-t4);
  flex-shrink: 0;
}
.notice-entry__arrow {
  font-size: 32rpx;
  color: var(--c-t4);
  flex-shrink: 0;
}

/* ---------------- 会话列表 ---------------- */
.conv-list {
  background: var(--c-card);
  border-radius: var(--r-m);
  margin: 0 var(--sp) var(--sp);
  overflow: hidden;
  box-shadow: var(--sh-1);
}

.conv {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 24rpx;
  position: relative;
}
.conv:active { background: var(--c-bg); }
.conv + .conv::before {
  content: '';
  position: absolute;
  left: 136rpx;
  right: 0;
  top: 0;
  height: 2rpx;
  background: var(--c-line);
}

.conv__avatar { position: relative; flex-shrink: 0; }
.conv__order-flag {
  position: absolute;
  right: -4rpx;
  bottom: -4rpx;
  width: 34rpx;
  height: 34rpx;
  border-radius: var(--r-full);
  background: var(--c-accent);
  color: var(--c-inverse);
  font-size: 20rpx;
  line-height: 34rpx;
  text-align: center;
  border: 3rpx solid var(--c-card);
}

.conv__main {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.conv__name {
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--c-t1);
  max-width: 380rpx;
}

.conv__time {
  font-size: var(--fs-mini);
  color: var(--c-t4);
  flex-shrink: 0;
  margin-left: 16rpx;
}

.conv__bottom { margin-top: 6rpx; }

.conv__msg {
  font-size: var(--fs-cap);
  color: var(--c-t2);
  max-width: 440rpx;
}

/* ---------------- 骨架屏 ---------------- */
.conv-sk {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 20rpx;
}
.conv-sk__avatar { width: 88rpx; height: 88rpx; border-radius: 50%; flex-shrink: 0; }
.conv-sk__line { height: 28rpx; margin-bottom: 16rpx; border-radius: 8rpx; }
