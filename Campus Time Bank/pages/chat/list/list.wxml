<!-- 消息列表：系统通知入口 + 会话列表 -->
<view class="page">
  <!-- ============ 系统通知入口卡 ============ -->
  <view class="notice-entry" bindtap="goNotice">
    <view class="notice-entry__icon">📢</view>
    <view class="flex-1">
      <view class="row">
        <text class="notice-entry__title">系统通知</text>
        <view wx:if="{{noticeUnread > 0}}" class="unread-dot notice-entry__dot">{{noticeUnread > 99 ? '99+' : noticeUnread}}</view>
      </view>
      <view class="notice-entry__desc ellipsis">
        {{notice ? notice.title + '：' + notice.content : '暂无新通知'}}
      </view>
    </view>
    <view class="notice-entry__time">{{notice ? notice.timeText : ''}}</view>
    <text class="notice-entry__arrow">›</text>
  </view>

  <!-- ============ 会话列表 ============ -->
  <view wx:if="{{list.length}}" class="conv-list">
    <view
      wx:for="{{list}}"
      wx:key="_id"
      class="conv"
      data-id="{{item._id}}"
      bindtap="openChat"
      bindlongpress="onChatLongPress"
    >
      <view class="conv__avatar">
        <user-avatar url="{{item.otherAvatar}}" name="{{item.otherName}}" size="m" />
        <view wx:if="{{item.orderId}}" class="conv__order-flag">单</view>
      </view>

      <view class="conv__main">
        <view class="between">
          <text class="conv__name ellipsis">{{item.otherName}}</text>
          <text class="conv__time">{{item.timeText}}</text>
        </view>
        <view class="between conv__bottom">
          <text class="conv__msg ellipsis">{{item.lastMsg || '开始聊天吧'}}</text>
          <view wx:if="{{item.unreadCount > 0}}" class="unread-dot">{{item.unreadText}}</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 加载中骨架 -->
  <view wx:elif="{{!firstLoaded}}" class="page-body">
    <view wx:for="{{[1,2,3,4]}}" wx:key="*this" class="card conv-sk">
      <view class="sk conv-sk__avatar"></view>
      <view class="flex-1">
        <view class="sk conv-sk__line" style="width:40%"></view>
        <view class="sk conv-sk__line" style="width:70%"></view>
      </view>
    </view>
  </view>

  <!-- 空态 -->
  <empty
    wx:elif="{{!list.length}}"
    icon="💬"
    text="还没有消息"
    desc="在技能详情页或订单里点「联系 TA」开始聊天"
  />

  <!-- 触底提示 -->
  <view wx:if="{{list.length}}" class="loading-more {{hasMore ? '' : 'loading-more--nomore'}}">
    {{loadingMore ? '加载中…' : (hasMore ? '上拉加载更多' : '没有更多了')}}
  </view>
</view>
