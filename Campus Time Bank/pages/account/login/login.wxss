/* 内部账户登录 */
.login-page {
  padding: var(--sp);
}

.login-hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 64rpx 32rpx 48rpx;
  text-align: center;
}

.login-hero__icon {
  font-size: 88rpx;
  line-height: 1;
}

.login-hero__title {
  margin-top: 24rpx;
  font-size: 40rpx;
  font-weight: 700;
  color: var(--c-t1);
}

.login-hero__desc {
  margin-top: 16rpx;
  font-size: var(--fs-mini);
  line-height: 1.6;
  color: var(--c-t3);
}

.login-eye {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: var(--fs-mini);
  color: var(--c-primary);
}

.login-submit {
  margin-top: 32rpx;
}

.login-submit.is-disabled {
  opacity: 0.6;
}

.login-tip {
  margin-top: 24rpx;
  padding: 0 8rpx;
  font-size: var(--fs-mini);
  line-height: 1.6;
  color: var(--c-t3);
}

.login-tip__strong {
  color: var(--c-danger);
  font-weight: 600;
}

/* 已登录时的账户卡片 */
.acc-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 8rpx 0;
}

.acc-row__icon {
  flex-shrink: 0;
  margin-right: 16rpx;
  font-size: 40rpx;
}

.acc-row__body {
  flex: 1;
}

.acc-row__name {
  display: block;
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--c-t1);
}

.acc-row__sub {
  display: block;
  margin-top: 6rpx;
  font-size: var(--fs-mini);
  color: var(--c-t3);
}
