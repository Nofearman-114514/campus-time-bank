/* 系统通知 */

/* ---------------- 顶部筛选行 ---------------- */
.notice-head {
  position: sticky;
  top: 0;
  z-index: 10;
  display: flex;
  flex-direction: row;
  align-items: center;
  background: var(--c-bg);
  padding: 20rpx 0 16rpx;
}

.filter-chip {
  flex-shrink: 0;
  height: 60rpx;
  padding: 0 26rpx;
  border-radius: var(--r-full);
  background: var(--c-card);
  color: var(--c-t2);
  font-size: var(--fs-cap);
  line-height: 60rpx;
  box-shadow: var(--sh-1);
}
.filter-chip.is-active {
  background: var(--c-primary);
  color: var(--c-inverse);
  font-weight: 500;
  box-shadow: var(--sh-primary);
}

.notice-head__readall {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8rpx;
  padding: 0 var(--sp) 0 16rpx;
  font-size: var(--fs-cap);
  color: var(--c-primary);
  flex-shrink: 0;
}
.notice-head__dot {
  min-width: 28rpx;
  height: 28rpx;
  line-height: 28rpx;
  font-size: 18rpx;
}

/* ---------------- 通知列表 ---------------- */
.notice-list {
  margin: 0 var(--sp) var(--sp);
  background: var(--c-card);
  border-radius: var(--r-m);
  overflow: hidden;
  box-shadow: var(--sh-1);
}

.notice {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: 16rpx;
  padding: 24rpx 24rpx 24rpx 8rpx;
  position: relative;
}
.notice:active { background: var(--c-bg); }
.notice + .notice::before {
  content: '';
  position: absolute;
  left: 100rpx;
  right: 0;
  top: 0;
  height: 2rpx;
  background: var(--c-line);
}
.notice.is-read .notice__title { color: var(--c-t2); }
.notice.is-read .notice__content { color: var(--c-t3); }

.notice__flag {
  width: 24rpx;
  display: flex;
  justify-content: center;
  padding-top: 14rpx;
  flex-shrink: 0;
}
.notice__dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--c-danger);
}

.notice__icon {
  width: 76rpx;
  height: 76rpx;
  border-radius: var(--r-full);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.notice__icon-emoji { font-size: 36rpx; line-height: 1; }

.notice__top { align-items: baseline; }

.notice__title {
  font-size: var(--fs-body);
  color: var(--c-t1);
  max-width: 400rpx;
}
.notice__title.is-bold { font-weight: 600; }

.notice__time {
  font-size: var(--fs-mini);
  color: var(--c-t4);
  flex-shrink: 0;
  margin-left: 12rpx;
}

.notice__content {
  margin-top: 8rpx;
  font-size: var(--fs-cap);
  color: var(--c-t2);
  line-height: 1.6;
}

.notice__foot {
  margin-top: 14rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}
.notice__action {
  font-size: var(--fs-mini);
  color: var(--c-primary);
}

/* ---------------- 骨架屏 ---------------- */
.notice-sk {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 20rpx;
}
.notice-sk__icon { width: 76rpx; height: 76rpx; border-radius: 50%; flex-shrink: 0; }
.notice-sk__line { height: 26rpx; margin-bottom: 16rpx; border-radius: 8rpx; }
