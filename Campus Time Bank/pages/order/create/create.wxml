<!-- 下单确认页 -->
<view class="page">

  <loading-skeleton wx:if="{{loading}}" type="detail" />

  <block wx:else>
    <view class="page-body page-body--has-bar">

      <!-- 信用分警告卡（醒目，且禁止提交） -->
      <view wx:if="{{creditBlocked}}" class="alert">
        <text class="alert__icon">⚠️</text>
        <view class="flex-1 col">
          <text class="alert__title">信用分不足，暂时不能下单</text>
          <text class="alert__desc">
            当前信用分 {{creditScore}} 分，低于平台要求的 {{minCredit}} 分。按时完成服务、收到好评可以提升信用分。
          </text>
        </view>
      </view>

      <!-- 1. 服务信息卡 -->
      <view class="card">
        <view class="row start gap">
          <view class="sv-cover">
            <image
              wx:if="{{skill.images.length}}"
              class="sv-cover__img"
              src="{{skill.images[0]}}"
              mode="aspectFill"
            />
            <text wx:else class="sv-cover__icon">{{coverIcon}}</text>
          </view>
          <view class="flex-1 col">
            <text class="sv-title ellipsis-2">{{skill.title || '—'}}</text>
            <view class="row gap-s mt-s">
              <text class="tag tag--info">{{skill.categoryName || '未分类'}}</text>
              <text class="tag">{{durationText}}</text>
            </view>
            <text class="sv-author">服务者：{{author.nickName || '同学'}}</text>
          </view>
        </view>
      </view>

      <!-- 2. 时间币结算卡（重点） -->
      <view class="card settle {{enough ? '' : 'settle--bad'}}">
        <view class="settle__row">
          <text class="settle__k">服务费用</text>
          <view class="coin">
            <view class="coin__icon">币</view>
            <text class="coin__num nums">{{amount}}</text>
          </view>
        </view>
        <view class="settle__row">
          <text class="settle__k">当前余额</text>
          <text class="settle__v nums">{{coins}} 枚</text>
        </view>
        <view class="divider"></view>
        <view class="settle__row">
          <text class="settle__k settle__k--strong">下单后余额</text>
          <text class="settle__v settle__v--strong nums">{{balanceAfter}} 枚</text>
        </view>
        <view wx:if="{{!enough}}" class="settle__warn">
          <text>时间币不足，还差 {{shortfall}} 枚。可以先去广场接单赚取时间币～</text>
        </view>
        <view wx:else class="settle__note">
          <text>其中 {{frozenCoins}} 枚为已冻结中的时间币，不参与本次结算。</text>
        </view>
      </view>

      <!-- 3. 冻结说明卡（答辩要点） -->
      <view class="card freeze">
        <view class="row">
          <text class="freeze__icon">🔒</text>
          <text class="freeze__title">时间币冻结说明</text>
        </view>
        <view class="freeze__body">
          <text>下单后 {{amount}} 枚时间币会被<text class="bold">冻结</text>，服务完成并由你确认后，才会真正结算给服务者。中途取消会原路退回。</text>
        </view>
        <view class="freeze__flow">
          <text class="freeze__step">下单冻结</text>
          <text class="freeze__arrow">→</text>
          <text class="freeze__step freeze__step--mid">服务完成</text>
          <text class="freeze__arrow">→</text>
          <text class="freeze__step freeze__step--end">确认结算</text>
        </view>
      </view>

      <!-- 4. 表单：期望时间 / 联系方式 / 留言 -->
      <view class="sec-title">
        <text class="sec-title__text">补充信息</text>
      </view>
      <view class="card form-card">
        <view class="form-item">
          <text class="form-item__label">期望日期</text>
          <picker mode="date" value="{{expectDate}}" bindchange="onDateChange">
            <view class="picker-box">
              <text class="form-item__input">{{expectDate || '请选择'}}</text>
              <text class="form-item__arrow">›</text>
            </view>
          </picker>
        </view>
        <view class="form-item">
          <text class="form-item__label">期望时间</text>
          <picker mode="time" value="{{expectTime}}" bindchange="onTimeChange">
            <view class="picker-box">
              <text class="form-item__input">{{expectTime || '请选择'}}</text>
              <text class="form-item__arrow">›</text>
            </view>
          </picker>
        </view>
        <view class="form-item">
          <text class="form-item__label">联系方式</text>
          <input
            class="form-item__input"
            value="{{contact}}"
            maxlength="40"
            placeholder="微信号 / 手机号（选填）"
            placeholder-class="form-item__ph"
            bindinput="onContactInput"
          />
        </view>
        <view class="form-item form-item--top">
          <text class="form-item__label">给服务者留言</text>
          <view class="flex-1 col">
            <textarea
              class="form-textarea form-textarea--sm"
              value="{{remark}}"
              maxlength="100"
              placeholder="说明你的具体需求，方便对方提前准备"
              placeholder-class="form-item__ph"
              bindinput="onRemarkInput"
            />
            <text class="char-count">{{remark.length}}/100</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 底部固定条 -->
    <view class="footer-bar">
      <view class="footer-bar__left col">
        <view class="coin">
          <view class="coin__icon">币</view>
          <text class="coin__num nums">{{amount}}</text>
        </view>
        <text class="footer-bar__label">{{creditBlocked ? '信用分不足，暂不能下单' : '下单后立即冻结'}}</text>
      </view>
      <view class="flex-1"></view>
      <view
        class="btn btn--lg footer-bar__btn {{(enough && !creditBlocked && !submitting) ? 'btn--primary' : 'btn--disabled'}}"
        bindtap="onSubmit"
      >{{submitting ? '提交中…' : '确认下单'}}</view>
    </view>
  </block>
</view>
