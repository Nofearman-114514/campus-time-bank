<!-- 发布技能 / 求助：整页主题色由 --c-theme 驱动（提供=绿 / 求助=蓝） -->
<view class="page page--theme" style="{{pageStyle}}">

  <!-- 二分切换 -->
  <view class="seg">
    <view
      class="seg__item {{!isNeed ? 'seg__item--on' : ''}}"
      data-type="offer"
      bindtap="onSwitchType"
    >
      <text class="seg__emoji">🎁</text>
      <text class="seg__text">我能提供</text>
    </view>
    <view
      class="seg__item {{isNeed ? 'seg__item--on' : ''}}"
      data-type="need"
      bindtap="onSwitchType"
    >
      <text class="seg__emoji">🙋</text>
      <text class="seg__text">我要求助</text>
    </view>
  </view>

  <!-- 身份提示 -->
  <view class="tip">
    <text class="tip__icon">💡</text>
    <text class="tip__text">{{job.tip}}</text>
  </view>

  <view class="page-body page-body--has-bar form-wrap">

    <!-- 标题 -->
    <view class="card form-card">
      <view class="form-item form-item--top">
        <text class="form-item__label form-item__label--required">标题</text>
        <view class="flex-1 col">
          <input
            class="form-item__input form-item__input--left"
            value="{{title}}"
            maxlength="{{TITLE_MAX}}"
            placeholder="{{job.phTitle}}"
            placeholder-class="form-item__ph"
            bindinput="onTitleInput"
          />
          <text class="char-count">{{title.length}}/{{TITLE_MAX}}</text>
        </view>
      </view>
    </view>

    <!-- 分类 / 时间币 / 时长 -->
    <view class="card form-card mt">
      <picker
        mode="selector"
        range="{{categoryNames}}"
        value="{{categoryIndex}}"
        bindchange="onCategoryChange"
      >
        <view class="form-item">
          <text class="form-item__label form-item__label--required">分类</text>
          <!-- ★ 插值必须紧贴标签写在同一行：换行/缩进会成为 <text> 的文本内容，
               把值推开并撑高行盒，看起来就是「文字歪了」 -->
          <text class="form-item__input {{categoryIndex < 0 ? 'form-item__ph' : ''}}">{{categoryIndex < 0 ? '请选择分类' : categoryNames[categoryIndex]}}</text>
          <text class="form-item__arrow">›</text>
        </view>
      </picker>

      <picker
        mode="selector"
        range="{{prices}}"
        value="{{priceIndex}}"
        bindchange="onPriceChange"
      >
        <view class="form-item">
          <text class="form-item__label form-item__label--required">时间币</text>
          <view class="coin">
            <view class="coin__icon">币</view>
            <text class="coin__num">{{prices[priceIndex]}}</text>
          </view>
          <text class="form-item__unit">枚 / 次</text>
          <view class="flex-1"></view>
          <text class="form-item__arrow">›</text>
        </view>
      </picker>

      <picker
        mode="selector"
        range="{{durations}}"
        range-key="text"
        value="{{durationIndex}}"
        bindchange="onDurationChange"
      >
        <view class="form-item">
          <text class="form-item__label form-item__label--required">时长</text>
          <text class="form-item__input">{{durations[durationIndex].text}}</text>
          <text class="form-item__arrow">›</text>
        </view>
      </picker>

      <!-- 大白话解释时间币 -->
      <view class="coin-tip">
        <text class="coin-tip__text">1 时间币 ≈ 1 小时服务，不可充值不可提现</text>
      </view>
    </view>

    <!-- 详情描述 -->
    <view class="card form-card mt">
      <view class="form-item form-item--top">
        <text class="form-item__label form-item__label--required">详情</text>
        <view class="flex-1 col">
          <textarea
            class="form-textarea"
            value="{{desc}}"
            maxlength="{{DESC_MAX}}"
            placeholder="{{job.phDesc}}"
            placeholder-class="form-item__ph"
            bindinput="onDescInput"
          />
          <text class="char-count {{desc.length < DESC_MIN ? 't-danger' : ''}}">{{desc.length}}/{{DESC_MAX}}（不少于 {{DESC_MIN}} 字）</text>
        </view>
      </view>
    </view>

    <!-- 技能标签 -->
    <view class="sec-title">
      <text class="sec-title__text">技能标签</text>
      <text class="sec-title__more">最多 {{TAG_MAX}} 个（{{tags.length}}/{{TAG_MAX}}）</text>
    </view>
    <view class="card form-card">
      <view wx:if="{{tags.length}}" class="tag-list">
        <view wx:for="{{tags}}" wx:key="*this" class="tag tag--primary tag--lg">
          <text>{{item}}</text>
          <text class="tag__del" data-index="{{index}}" catchtap="onTagRemove">×</text>
        </view>
      </view>
      <input
        class="tag-input"
        value="{{tagInput}}"
        placeholder="{{job.phTag}}"
        placeholder-class="form-item__ph"
        confirm-type="done"
        bindinput="onTagInput"
        bindconfirm="onTagConfirm"
      />
      <view class="tag-add" bindtap="onTagConfirm">+ 添加标签</view>
    </view>

    <!-- 图片 -->
    <view class="sec-title">
      <text class="sec-title__text">图片</text>
      <text class="sec-title__more">{{images.length}}/{{IMG_MAX}}</text>
    </view>
    <view class="card form-card">
      <view class="img-list">
        <view wx:for="{{images}}" wx:key="path" class="img-item">
          <image class="img-item__pic" src="{{item.path}}" mode="aspectFill" data-index="{{index}}" bindtap="onPreviewImage" />
          <view wx:if="{{item.local}}" class="img-item__flag">待上传</view>
          <view class="img-item__del" data-index="{{index}}" catchtap="onRemoveImage">×</view>
        </view>
        <view wx:if="{{images.length < IMG_MAX}}" class="img-add" bindtap="onAddImage">
          <text class="img-add__plus">+</text>
          <text class="img-add__text">上传图片</text>
        </view>
      </view>
    </view>

    <!-- 服务地点 -->
    <view class="sec-title">
      <text class="sec-title__text">服务地点</text>
      <text class="sec-title__more sec-title__more--must">必选 · 仅限校内</text>
    </view>

    <!-- ★ 安全策略提示：必须让用户一眼看到，而不是提交时才被拒 -->
    <view class="campus-rule">
      <text class="campus-rule__icon">🏫</text>
      <text class="campus-rule__text">只能发布<text class="campus-rule__strong">校内</text>的任务。校外的任务一旦出现纠纷或意外，校方无法及时处理，因此不会通过审核。</text>
    </view>

    <view class="card form-card">
      <view class="form-item" bindtap="onPickLocation">
        <text class="form-item__label">地点</text>
        <block wx:if="{{locationName}}">
          <view class="flex-1 col">
            <text class="loc-name">{{locationName}}</text>
            <text wx:if="{{address}}" class="loc-addr ellipsis">{{address}}</text>
          </view>
          <text class="loc-clear" catchtap="onClearLocation">清除</text>
        </block>
        <block wx:else>
          <text class="form-item__input form-item__ph">点我选择地点</text>
          <text class="form-item__arrow">›</text>
        </block>
      </view>
    </view>
  </view>

  <!-- 底部固定提交条 -->
  <view class="footer-bar">
    <view class="footer-bar__left col">
      <text class="footer-bar__hint">发布后会消耗 0 时间币</text>
      <text class="footer-bar__sub">时间币在同学下单时才会冻结</text>
    </view>
    <view
      class="btn btn--primary btn--lg footer-bar__btn {{submitting ? 'btn--disabled' : ''}}"
      bindtap="onSubmit"
    >{{isEdit ? '保存修改' : '立即发布'}}</view>
  </view>

  <!-- 上传进度蒙层 -->
  <view wx:if="{{uploading}}" class="mask center">
    <view class="upload-box col center">
      <text class="upload-box__icon">☁️</text>
      <text class="upload-box__text">{{uploadText}}</text>
      <text class="upload-box__sub">请勿退出页面</text>
    </view>
  </view>
</view>
