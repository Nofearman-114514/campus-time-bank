/* ==================================================================
 * 发布技能 / 求助
 * 主题色全部走 --c-theme（由 js 按身份注入 token），此处不出现硬编码色值
 * ================================================================== */

/* 整页主题：导航/背景上用主题浅底，与底部按钮同色系 */
.page--theme { background: var(--c-bg); }

/* 表单卡片：内部 .form-item 自带左右内边距，卡片去掉 padding 只保留圆角 */
.form-card {
  padding: 0;
  overflow: hidden;
}
.form-card .form-item:last-child { padding-bottom: 8rpx; }

/* ---------------------------- 二分切换 ---------------------------- */
.seg {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: var(--sp) var(--sp) 0;
  padding: 8rpx;
  background: var(--c-card);
  border-radius: var(--r-full);
  box-shadow: var(--sh-1);
}
.seg__item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  height: 76rpx;
  border-radius: var(--r-full);
  font-size: var(--fs-body);
  color: var(--c-t2);
  transition: all .18s;
}
.seg__item--on {
  background: var(--c-theme);
  color: #fff;
  font-weight: 600;
  box-shadow: var(--sh-1);
}
.seg__emoji { font-size: 32rpx; }
.seg__text { line-height: 1; }

/* ---------------------------- 身份提示 ---------------------------- */
.tip {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  margin: 20rpx var(--sp) 0;
  padding: 20rpx var(--sp);
  border-radius: var(--r-m);
  background: var(--c-theme-l);
}
.tip__icon { font-size: 28rpx; line-height: 1.5; }
.tip__text {
  flex: 1;
  font-size: var(--fs-cap);
  line-height: 1.6;
  color: var(--c-t2);
}

/* 表单容器：紧贴提示下方，底部给固定条留白 */
.form-wrap { padding-top: 20rpx; }

/* 表单里的箭头
   ★ 用「固定尺寸盒子 + flex 居中」而不是只给 line-height：
     `›` 这个字形在不同字体里的上下位置差异很大（PC 字体 vs 手机字体），
     只靠 line-height 的话，真机上箭头会相对文字上下偏移。 */
.form-item__arrow {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36rpx;
  height: 36rpx;
  margin-left: 8rpx;
  color: var(--c-t4);
  font-size: 32rpx;
  line-height: 1;
}

/* ---------------------------- 时间币解释 ---------------------------- */
.coin-tip {
  padding: 16rpx var(--sp) 20rpx;
  background: var(--c-accent-l);
  border-radius: 0 0 var(--r-m) var(--r-m);
}
.coin-tip__text {
  font-size: var(--fs-mini);
  color: var(--c-accent);
  line-height: 1.6;
}

/* ---------------------------- 标签 ---------------------------- */
.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 20rpx var(--sp) 0;
}
.tag__del {
  margin-left: 10rpx;
  font-size: 30rpx;
  line-height: 1;
  color: inherit;
  opacity: .75;
}
.tag-input {
  height: 88rpx;
  padding: 0 var(--sp);
  font-size: var(--fs-body);
  color: var(--c-t1);
}
.tag-add {
  display: inline-flex;
  align-items: center;
  height: 60rpx;
  margin: 0 var(--sp) 20rpx;
  padding: 0 24rpx;
  border-radius: var(--r-full);
  font-size: var(--fs-cap);
  color: var(--c-theme);
  background: var(--c-theme-l);
}

/* ---------------------------- 图片 ---------------------------- */
.img-list {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  padding: 24rpx var(--sp);
}
.img-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: var(--r-s);
  overflow: hidden;
  background: var(--c-bg);
}
.img-item__pic { width: 100%; height: 100%; }
.img-item__flag {
  position: absolute;
  left: 0;
  bottom: 0;
  right: 0;
  padding: 4rpx 0;
  text-align: center;
  font-size: 20rpx;
  color: #fff;
  background: var(--c-warn);
}
.img-item__del {
  position: absolute;
  right: 0;
  top: 0;
  width: 44rpx;
  height: 44rpx;
  line-height: 40rpx;
  text-align: center;
  font-size: 32rpx;
  color: #fff;
  background: var(--c-mask);
  border-radius: 0 0 0 var(--r-s);
}
.img-add {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 200rpx;
  height: 200rpx;
  border-radius: var(--r-s);
  border: 2rpx dashed var(--c-t4);
  color: var(--c-t3);
}
.img-add__plus { font-size: 56rpx; line-height: 1; }
.img-add__text { margin-top: 8rpx; font-size: var(--fs-mini); }

/* ---------------------------- 地点 ---------------------------- */
.loc-name {
  font-size: var(--fs-body);
  color: var(--c-t1);
  text-align: right;
}
.loc-addr {
  margin-top: 6rpx;
  font-size: var(--fs-mini);
  color: var(--c-t3);
  text-align: right;
  max-width: 380rpx;
}
.loc-clear {
  margin-left: 20rpx;
  font-size: var(--fs-cap);
  color: var(--c-t3);
}

/* ---------------------------- 底部固定条 ---------------------------- */
.footer-bar__left { flex: 1; min-width: 0; }
.footer-bar__hint {
  font-size: var(--fs-cap);
  color: var(--c-t1);
  font-weight: 600;
}
.footer-bar__sub {
  margin-top: 4rpx;
  font-size: var(--fs-mini);
  color: var(--c-t3);
}
.footer-bar__btn {
  flex-shrink: 0;
  min-width: 260rpx;
  background: var(--c-theme);
}

/* ---------------------------- 上传蒙层 ---------------------------- */
.upload-box {
  width: 320rpx;
  padding: 40rpx 0;
  border-radius: var(--r-l);
  background: var(--c-card);
}
.upload-box__icon { font-size: 64rpx; line-height: 1; }
.upload-box__text {
  margin-top: 16rpx;
  font-size: var(--fs-body);
  color: var(--c-t1);
}
.upload-box__sub {
  margin-top: 8rpx;
  font-size: var(--fs-mini);
  color: var(--c-t3);
}

/* ==================================================================
   ★ 安全策略：只能发布校内任务
   —— 必须在提交之前就让用户看见，而不是填完一整页才被拒
   ================================================================== */
.sec-title__more--must {
  color: var(--c-danger);
  font-weight: 600;
}

.campus-rule {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  margin-bottom: 16rpx;
  padding: 18rpx 22rpx;
  border-radius: var(--r-m);
  background: var(--c-danger-l);
}

.campus-rule__icon {
  flex-shrink: 0;
  margin-right: 10rpx;
  font-size: var(--fs-cap);
}

.campus-rule__text {
  flex: 1;
  font-size: var(--fs-mini);
  line-height: 1.6;
  color: var(--c-t1);
}

.campus-rule__strong {
  color: var(--c-danger);
  font-weight: 700;
}
