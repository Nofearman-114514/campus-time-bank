/* 贡献排行榜 */
.rank-page { padding: var(--sp); }

.rk-me {
  display: flex; flex-direction: row; align-items: center;
  padding: 32rpx var(--sp); margin-bottom: 20rpx;
  background: linear-gradient(135deg, var(--c-primary), var(--c-primary-d, #0B8A66));
  border-radius: 20rpx; color: #fff;
}
.rk-me__left { width: 220rpx; text-align: center; }
.rk-me__label { display: block; font-size: var(--fs-mini); opacity: .85; }
.rk-me__rank { display: block; margin-top: 6rpx; font-size: 64rpx; font-weight: 700; line-height: 1; }
.rk-me__right { flex: 1; }
.rk-me__row { display: flex; flex-direction: row; justify-content: space-between; padding: 6rpx 0; }
.rk-me__k { font-size: var(--fs-mini); opacity: .85; }
.rk-me__v { font-size: var(--fs-mini); font-weight: 600; }

.rk-switch { display: flex; flex-direction: row; align-items: center; }
.rk-switch__body { flex: 1; margin-right: 20rpx; }
.rk-switch__title { display: block; font-size: var(--fs-body); color: var(--c-t1); }
.rk-switch__desc { display: block; margin-top: 8rpx; font-size: var(--fs-mini); color: var(--c-t3); line-height: 1.6; }

.rk-tip { margin: 20rpx 0; font-size: var(--fs-mini); color: var(--c-t3); line-height: 1.6; }

.rk-list { padding: 0 var(--sp); }
.rk-item {
  display: flex; flex-direction: row; align-items: center;
  padding: 22rpx 0;
  border-bottom: 2rpx solid var(--c-line, #F2F2F2);
}
.rk-item:last-child { border-bottom: none; }
.rk-item--me { background: var(--c-primary-l, #E8F6F1); margin: 0 -16rpx; padding-left: 16rpx; padding-right: 16rpx; border-radius: 10rpx; }
.rk-item__rank {
  width: 64rpx; text-align: center;
  font-size: 32rpx; font-weight: 700; color: var(--c-t2);
}
.rk-avatar {
  width: 72rpx; height: 72rpx; margin-right: 18rpx;
  border-radius: 50%; background: var(--c-bg, #F2F3F5);
  color: var(--c-t2); font-size: 32rpx;
  display: flex; align-items: center; justify-content: center;
}
.rk-item__body { flex: 1; }
.rk-item__name { display: block; font-size: var(--fs-body); color: var(--c-t1); font-weight: 500; }
.rk-item__sub { display: block; margin-top: 6rpx; font-size: 22rpx; color: var(--c-t3); }
.rk-item__num { text-align: right; }
.rk-item__earn { font-size: 38rpx; font-weight: 700; color: var(--c-accent, #E8912D); }
.rk-item__unit { margin-left: 4rpx; font-size: 22rpx; color: var(--c-t3); }

.rk-empty { padding: 80rpx 0; text-align: center; color: var(--c-t3); font-size: var(--fs-mini); }
.rk-foot { margin-top: 24rpx; font-size: var(--fs-mini); color: var(--c-t3); line-height: 1.6; }
