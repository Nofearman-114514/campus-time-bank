<!-- 举报 -->
<view class="page page-body page-body--has-bar">

  <!-- ============ 平台提示 ============ -->
  <view class="report-tip">
    <text class="report-tip__icon">🛡️</text>
    <text class="report-tip__text">我们会保护举报人隐私，恶意举报会影响你的信用分</text>
  </view>

  <!-- ============ 被举报对象 ============ -->
  <view class="card target-card">
    <view class="target-card__label">举报对象</view>
    <view class="row target-card__row">
      <text class="tag tag--danger">{{targetTypeText}}</text>
      <text class="target-card__title ellipsis">{{targetTitle || '未命名内容'}}</text>
    </view>
    <view class="target-card__id">编号：{{targetId || '—'}}</view>
  </view>

  <!-- ============ 举报原因（单选） ============ -->
  <view class="sec-title">
    <text class="sec-title__text">举报原因</text>
    <text class="sec-title__more">必选</text>
  </view>

  <view class="reason-list">
    <view
      wx:for="{{reasons}}"
      wx:key="*this"
      class="reason {{reasonIndex === index ? 'is-active' : ''}}"
      data-index="{{index}}"
      bindtap="onPickReason"
    >
      <view class="reason__radio">
        <view wx:if="{{reasonIndex === index}}" class="reason__radio-dot"></view>
      </view>
      <text class="reason__text flex-1">{{item}}</text>
    </view>
  </view>

  <!-- ============ 补充说明 ============ -->
  <view class="sec-title">
    <text class="sec-title__text">补充说明</text>
    <text class="sec-title__more">选填</text>
  </view>

  <view class="card">
    <textarea
      class="form-textarea"
      value="{{remark}}"
      maxlength="200"
      placeholder="请描述具体情况，便于我们更快核实（如时间、地点、聊天记录要点）"
      placeholder-class="form-item__ph"
      bindinput="onRemark"
    />
  </view>
  <view class="char-count">{{remarkLen}}/200</view>

  <!-- ============ 凭证图片 ============ -->
  <view class="sec-title">
    <text class="sec-title__text">凭证图片</text>
    <text class="sec-title__more">{{images.length}}/{{maxImages}}</text>
  </view>

  <view class="card">
    <view class="uploader">
      <view
        wx:for="{{images}}"
        wx:key="*this"
        class="uploader__item"
      >
        <image class="uploader__img" src="{{item}}" mode="aspectFill" data-url="{{item}}" bindtap="onPreview" />
        <view class="uploader__del" data-index="{{index}}" catchtap="onRemoveImage">×</view>
      </view>

      <view wx:if="{{images.length < maxImages}}" class="uploader__add" bindtap="onAddImage">
        <text class="uploader__add-icon">＋</text>
        <text class="uploader__add-text">上传凭证</text>
      </view>
    </view>
    <view class="uploader__tip">最多 3 张，仅用于核实举报，不会公开展示</view>
  </view>

  <view wx:if="{{mockMode}}" class="mock-note">当前为离线预览模式，凭证图片不会真正上传云存储</view>

  <!-- ============ 底部提交 ============ -->
  <view class="footer-bar">
    <view
      class="btn btn--danger btn--block {{submitting ? 'btn--disabled' : ''}}"
      bindtap="onSubmit"
    >{{submitting ? '提交中…' : '提交举报'}}</view>
  </view>
</view>
