<!-- 管理端 · 订单管理 -->
<view class="admin-page">

  <!-- ==================== 标识条 ==================== -->
  <view class="admin-bar">
    <view class="admin-bar__shield">🛡</view>
    <view class="admin-bar__main">
      <view class="admin-bar__kicker">管理员控制台</view>
      <view class="admin-bar__title">订单管理</view>
      <view class="admin-bar__sub">全站订单 · 点行展开时间轴与取消原因</view>
    </view>
    <view class="admin-bar__side">
      <view class="admin-bar__num">{{total}}</view>
      <view class="admin-bar__label">命中订单</view>
    </view>
  </view>

  <!-- ==================== 顶部状态统计条（兼筛选） ==================== -->
  <view class="admin-toolbar">
    <view class="admin-search">
      <text class="admin-search__icon">🔍</text>
      <input
        class="admin-search__input"
        type="text"
        value="{{keyword}}"
        placeholder="搜索订单号 / 技能标题"
        placeholder-class="admin-search__ph"
        confirm-type="search"
        bindinput="onKeyword"
      />
      <text wx:if="{{keyword}}" class="admin-search__clear" bindtap="clearKeyword">✕</text>
    </view>
    <view class="admin-chips">
      <view
        wx:for="{{statusOptions}}"
        wx:key="v"
        class="chip {{status === item.v ? 'chip--on' : ''}}"
        data-v="{{item.v}}"
        bindtap="onStatusTab"
      >{{item.t}}<text wx:if="{{item.count !== null}}" class="chip__n">{{item.count}}</text></view>
    </view>
  </view>

  <!-- ==================== 列表 ==================== -->
  <view class="admin-panel">
    <view class="admin-panel__head">
      <text class="admin-panel__title">订单列表</text>
      <text class="admin-panel__hint">共 {{total}} 条</text>
    </view>

    <view wx:for="{{list}}" wx:key="_id" class="order-row">
      <view class="arow arow--tap" data-id="{{item._id}}" bindtap="toggleExpand">
        <view class="arow__main">
          <view class="row gap-s">
            <text class="order-no" data-no="{{item.orderNo}}" catchtap="copyOrderNo">{{item.orderNo}}</text>
            <text class="tag tag--outline" style="color:{{item.statusColor}}">{{item.statusText}}</text>
          </view>
          <view class="arow__title ellipsis mt-s">{{item.skillTitle}}</view>
          <view class="agrid">
            <text class="agrid__kv">
              <text class="k">买家 </text><text class="v" data-openid="{{item.buyerId}}" catchtap="goUser">{{item.buyerName}}</text>
            </text>
            <text class="agrid__kv">
              <text class="k">服务者 </text><text class="v" data-openid="{{item.sellerId}}" catchtap="goUser">{{item.sellerName}}</text>
            </text>
            <text class="agrid__kv"><text class="k">时间币 </text><text class="v">{{item.amount}}</text></text>
            <text class="agrid__kv"><text class="k">下单 </text><text class="v">{{item.createTimeText}}</text></text>
          </view>
        </view>
        <view class="arow__side">
          <text class="order-more">{{expandedId === item._id ? '收起 ▲' : '展开 ▼'}}</text>
        </view>
      </view>

      <!-- 展开详情：留言 / 时间轴 / 取消原因 -->
      <view wx:if="{{expandedId === item._id}}" class="order-detail">
        <view class="order-detail__kv">
          <text class="k">买家留言</text>
          <text class="v">{{item.remark || '无'}}</text>
        </view>
        <view class="order-detail__kv">
          <text class="k">期望时间</text>
          <text class="v">{{item.expectTime || '未填写'}}</text>
        </view>
        <view class="order-detail__kv">
          <text class="k">联系方式</text>
          <text class="v">{{item.contact || '未填写'}}</text>
        </view>
        <view wx:if="{{item.cancelReason}}" class="order-detail__kv">
          <text class="k">取消原因</text>
          <text class="v t-danger">{{item.cancelReason}}（{{item.cancelBy === 'seller' ? '服务者' : (item.cancelBy === 'buyer' ? '买家' : '系统')}}）</text>
        </view>
        <view wx:if="{{item.buyerScore || item.sellerScore}}" class="order-detail__kv">
          <text class="k">订单评分</text>
          <text class="v">买家给 {{item.buyerScore || '—' }} 星 · 服务者给 {{item.sellerScore || '—'}} 星</text>
        </view>

        <view class="order-timeline">
          <view class="order-timeline__title">状态时间轴（最近 {{item.timelineView.length}} 条 / 共 {{item.timeline.length}} 条）</view>
          <view wx:for="{{item.timelineView}}" wx:for-item="node" wx:key="idx" class="order-timeline__i">
            <view class="dot dot--{{node.status}}"></view>
            <view class="flex-1">
              <view class="order-timeline__t">{{node.text}}</view>
              <view class="order-timeline__r">{{node.remark || '—'}}</view>
            </view>
            <text class="order-timeline__time">{{node.timeText}}</text>
          </view>
          <view wx:if="{{!item.timelineView.length}}" class="order-timeline__r">该订单没有时间轴记录</view>
        </view>

        <view class="admin-actions">
          <button class="btn btn--xs btn--gray" data-id="{{item.skillId}}" bindtap="goSkill">查看技能</button>
          <button class="btn btn--xs btn--gray" data-no="{{item.orderNo}}" bindtap="copyOrderNo">复制订单号</button>
        </view>
      </view>
    </view>

    <view wx:if="{{loading}}" class="page-body">
      <loading-skeleton type="list" count="{{4}}" />
    </view>

    <empty
      wx:elif="{{!list.length}}"
      icon="📦"
      text="没有符合条件的订单"
      desc="换个订单号 / 关键词，或把状态调回「全部」"
    />

    <view wx:if="{{list.length}}" class="loading-more {{hasMore ? '' : 'loading-more--nomore'}}">
      {{loadingMore ? '加载中…' : (hasMore ? '上拉加载更多' : '没有更多了')}}
    </view>
  </view>

  <view class="admin-footer">时间币仅在订单完成时结算给服务者，取消/拒单会解冻退回买家</view>
</view>
