@import "../../utils/admin.wxss";

/* ==================================================================
 * 订单管理
 * ================================================================== */

/* 统计条里的数字 */
.chip__n {
  margin-left: 8rpx;
  font-size: 20rpx;
  opacity: .8;
  font-variant-numeric: tabular-nums;
}

/* 订单号：等宽、可点击复制 */
.order-no {
  font-size: var(--fs-mini);
  color: var(--c-t2);
  font-variant-numeric: tabular-nums;
  letter-spacing: 1rpx;
}

.order-more {
  font-size: var(--fs-mini);
  color: var(--c-primary);
}

/* 展开区 */
.order-row { position: relative; }
.order-row + .order-row::before {
  content: '';
  position: absolute;
  left: var(--sp);
  right: 0;
  top: 0;
  height: 2rpx;
  background: var(--c-line);
}
.order-detail {
  padding: 20rpx var(--sp) 24rpx;
  background: var(--c-bg);
}
.order-detail__kv {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  font-size: var(--fs-mini);
  padding: 8rpx 0;
}
.order-detail__kv .k {
  width: 150rpx;
  flex-shrink: 0;
  color: var(--c-t3);
}
.order-detail__kv .v {
  flex: 1;
  min-width: 0;
  color: var(--c-t1);
  word-break: break-all;
}

/* 时间轴 */
.order-timeline {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 2rpx dashed var(--c-line);
}
.order-timeline__title {
  font-size: var(--fs-mini);
  color: var(--c-t3);
  margin-bottom: 12rpx;
}
.order-timeline__i {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  padding: 10rpx 0;
}
.order-timeline__i .dot { margin-top: 12rpx; }
.order-timeline__t {
  font-size: var(--fs-mini);
  color: var(--c-t1);
  font-weight: 600;
}
.order-timeline__r {
  font-size: var(--fs-mini);
  color: var(--c-t3);
  line-height: 1.5;
}
.order-timeline__time {
  flex-shrink: 0;
  font-size: 20rpx;
  color: var(--c-t4);
}
